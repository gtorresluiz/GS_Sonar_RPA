# Copie para .env (o .env NÃO vai para o Git) e preencha.
OLHOVIVO_TOKEN=cole-seu-token-aqui
OLHOVIVO_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
# Remetente dos e-mails (o mesmo e-mail configurado na credencial SMTP do n8n)
SONAR_EMAIL_FROM=seu.email@gmail.com
# Recebe alertas quando a API cair (deixe vazio para desativar)
SONAR_ADMIN_EMAIL=seu.email@gmail.com
# Sal usado para pseudonimizar o id do usuário nos logs (LGPD). Troque por um texto aleatório.
SONAR_HASH_SALT=troque-por-um-texto-aleatorio
