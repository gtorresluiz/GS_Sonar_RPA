<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_sentinela" targetNamespace="http://fiap.com.br/gs/sonar">
<bpmn:collaboration id="colab"><bpmn:participant id="pool" name="Robô Sentinela Sonar (n8n)" processRef="sentinela" /></bpmn:collaboration>
<bpmn:process id="sentinela" name="Sentinela Sonar" isExecutable="false">
<bpmn:startEvent id="start" name="A cada 1 minuto"><bpmn:outgoing>f0</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:scriptTask id="ler" name="Ler cadastros (data/cadastros.json)"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="gwArq" name="Arquivo legível?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="logArq" name="Registrar erro no log"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="endArq" name="Execução falha (erro explícito)"><bpmn:incoming>f4</bpmn:incoming><bpmn:errorEventDefinition /></bpmn:endEvent>
<bpmn:scriptTask id="validar" name="Validar, remover duplicados e filtrar janela de horário"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:scriptTask>
<bpmn:exclusiveGateway id="gwJanela" name="Há cadastros na janela?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="endVazio" name="Ciclo encerrado"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="login" name="Autenticar na API Olho Vivo (até 3 tentativas)"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gwLogin" name="Login OK?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="falha" name="Registrar falha e marcar api_disponivel=false para o MVP"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="gwAlerta" name="Admin alertado há &lt; 30 min?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="endSup" name="Fim (alerta suprimido)"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="alerta" name="Enviar e-mail de alerta ao administrador"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="endFalha" name="Fim (nova tentativa no próximo ciclo)"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="agrupar" name="Agrupar cadastros por parada"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:scriptTask>
<bpmn:serviceTask id="consultar" name="Consultar previsão de cada parada (2 tentativas)"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:serviceTask>
<bpmn:scriptTask id="avaliar" name="Para cada cadastro: aplicar regras 1–3 e deduplicação"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:scriptTask>
<bpmn:scriptTask id="gravar" name="Gravar status_mvp.json e log de decisões"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="gwNotif" name="Deve notificar?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="endSem" name="Sem notificação"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="email" name="Enviar e-mail ao usuário"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:sendTask>
<bpmn:exclusiveGateway id="gwEnvio" name="E-mail enviado?"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="marcar" name="Marcar aviso como enviado + log"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="endOk" name="Fim do ciclo"><bpmn:incoming>f24</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="logEnvio" name="Registrar falha de envio (reenvia no próximo ciclo)"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="endEnvio" name="Fim do ciclo"><bpmn:incoming>f25</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f0" name="" sourceRef="start" targetRef="ler" />
<bpmn:sequenceFlow id="f1" name="" sourceRef="ler" targetRef="gwArq" />
<bpmn:sequenceFlow id="f2" name="sim" sourceRef="gwArq" targetRef="validar" />
<bpmn:sequenceFlow id="f3" name="não" sourceRef="gwArq" targetRef="logArq" />
<bpmn:sequenceFlow id="f4" name="" sourceRef="logArq" targetRef="endArq" />
<bpmn:sequenceFlow id="f5" name="" sourceRef="validar" targetRef="gwJanela" />
<bpmn:sequenceFlow id="f6" name="sim" sourceRef="gwJanela" targetRef="login" />
<bpmn:sequenceFlow id="f7" name="não" sourceRef="gwJanela" targetRef="endVazio" />
<bpmn:sequenceFlow id="f8" name="" sourceRef="login" targetRef="gwLogin" />
<bpmn:sequenceFlow id="f9" name="sim" sourceRef="gwLogin" targetRef="agrupar" />
<bpmn:sequenceFlow id="f10" name="não / erro" sourceRef="gwLogin" targetRef="falha" />
<bpmn:sequenceFlow id="f11" name="" sourceRef="falha" targetRef="gwAlerta" />
<bpmn:sequenceFlow id="f12" name="sim" sourceRef="gwAlerta" targetRef="endSup" />
<bpmn:sequenceFlow id="f13" name="não" sourceRef="gwAlerta" targetRef="alerta" />
<bpmn:sequenceFlow id="f14" name="" sourceRef="alerta" targetRef="endFalha" />
<bpmn:sequenceFlow id="f15" name="" sourceRef="agrupar" targetRef="consultar" />
<bpmn:sequenceFlow id="f16" name="" sourceRef="consultar" targetRef="avaliar" />
<bpmn:sequenceFlow id="f17" name="" sourceRef="avaliar" targetRef="gravar" />
<bpmn:sequenceFlow id="f18" name="" sourceRef="gravar" targetRef="gwNotif" />
<bpmn:sequenceFlow id="f19" name="sim" sourceRef="gwNotif" targetRef="email" />
<bpmn:sequenceFlow id="f20" name="não" sourceRef="gwNotif" targetRef="endSem" />
<bpmn:sequenceFlow id="f21" name="" sourceRef="email" targetRef="gwEnvio" />
<bpmn:sequenceFlow id="f22" name="sim" sourceRef="gwEnvio" targetRef="marcar" />
<bpmn:sequenceFlow id="f23" name="não" sourceRef="gwEnvio" targetRef="logEnvio" />
<bpmn:sequenceFlow id="f24" name="" sourceRef="marcar" targetRef="endOk" />
<bpmn:sequenceFlow id="f25" name="" sourceRef="logEnvio" targetRef="endEnvio" />
<bpmn:textAnnotation id="nota"><bpmn:text>Regras de negócio (por cadastro)
R1: ônibus ACESSÍVEL a ≤ limiar → aviso "está chegando"
      (+ alerta se antes passa um não acessível)
R2: próximo ônibus NÃO acessível a ≤ limiar → alerta com
      tempo até o próximo acessível
R3: nada perto → aguardando (sem envio)
Sem repetição: mesmo aviso 1x a cada 90 min;
alerta R2 no máx. 1x a cada 15 min por cadastro</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="assocNota" sourceRef="avaliar" targetRef="nota" />
</bpmn:process>
<bpmndi:BPMNDiagram id="diag"><bpmndi:BPMNPlane id="plano" bpmnElement="colab">
<bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="-10" y="110" width="2250" height="610" /></bpmndi:BPMNShape>
