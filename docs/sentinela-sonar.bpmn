<bpmndi:BPMNShape id="endSem_di" bpmnElement="endSem"><dc:Bounds x="1612" y="352" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="email_di" bpmnElement="email"><dc:Bounds x="1705" y="170" width="130" height="80" /></bpmndi:BPMNShape>
