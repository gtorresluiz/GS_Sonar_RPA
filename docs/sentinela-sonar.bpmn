<bpmndi:BPMNShape id="marcar_di" bpmnElement="marcar"><dc:Bounds x="1985" y="170" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="endOk_di" bpmnElement="endOk"><dc:Bounds x="2162" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="logEnvio_di" bpmnElement="logEnvio"><dc:Bounds x="1845" y="330" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="endEnvio_di" bpmnElement="endEnvio"><dc:Bounds x="2032" y="352" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="98" y="210" /><di:waypoint x="135" y="210" /></bpmndi:BPMNEdge>
