<bpmndi:BPMNShape id="consultar_di" bpmnElement="consultar"><dc:Bounds x="1125" y="170" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="avaliar_di" bpmnElement="avaliar"><dc:Bounds x="1275" y="170" width="130" height="80" /></bpmndi:BPMNShape>
